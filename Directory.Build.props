<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <NuclearOptionDir Condition="'$(NuclearOptionDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</NuclearOptionDir>
    <BaseIntermediateOutputPath>obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!-- The exact Git commit is recorded in release-manifest.json, not embedded in assemblies. -->
    <SourceRevisionId Condition="'$(SourceRevisionId)' == ''">0000000000000000000000000000000000000000</SourceRevisionId>
  </PropertyGroup>
</Project>
